{
  "type": "record",
  "name": "EventHeader",
  "namespace": "com.marketstream.avro",
  "doc": "Standard header on every canonical event (section 12.2). Kept in avro-shared/ rather than avro/ so avro-maven-plugin compiles it exactly once via <imports>.",
  "fields": [
    {
      "name": "eventId",
      "type": {"type": "string", "logicalType": "uuid"},
      "doc": "Unique ID for this event, assigned at creation."
    },
    {
      "name": "exchange",
      "type": {
        "type": "enum",
        "name": "Exchange",
        "symbols": ["KRAKEN"],
        "doc": "Extensible: adding a symbol is a BACKWARD-compatible change."
      }
    },
    {
      "name": "instrument",
      "type": "string",
      "doc": "Canonical symbol, e.g. BTC/USD. With exchange, forms the partition key."
    },
    {
      "name": "eventTime",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Exchange event time: the authoritative business time for all windowing."
    },
    {
      "name": "ingestionTime",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "When the ingestor received the frame. Used for latency and as skew fallback."
    },
    {
      "name": "processingTime",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "When the processor emitted this record. Observability only, never windowing."
    },
    {
      "name": "eventTimeSource",
      "type": {
        "type": "enum",
        "name": "EventTimeSource",
        "symbols": ["EXCHANGE", "INGESTION_FALLBACK"]
      },
      "doc": "Whether eventTime came from the exchange or fell back to ingestion time."
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1,
      "doc": "Logical schema version, complementing the registry-assigned ID."
    },
    {
      "name": "traceId",
      "type": "string",
      "doc": "Propagated from the raw envelope so one trade is followable end to end."
    },
    {
      "name": "sourceEventId",
      "type": ["null", {"type": "string", "logicalType": "uuid"}],
      "default": null,
      "doc": "The upstream event this was derived from (lineage)."
    }
  ]
}
